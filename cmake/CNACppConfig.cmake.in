# SPDX-License-Identifier: MS-PL
@PACKAGE_INIT@

set(CNA_RUNTIME_VERSION "@CNA_VERSION_STRING@")
set(CNA_CPP_COMPONENTS "@CNA_CPP_COMPONENTS@")
if(TARGET CNA::CNA)
    get_target_property(_cna_sdk_loaded CNA::CNA CNA_INSTALLED_SDK)
    if(_cna_sdk_loaded)
        return()
    endif()
endif()
if(@CNA_SHARED_LIBRARY@ AND CMAKE_VERSION VERSION_LESS 3.30)
    set(CNA_FOUND FALSE)
    set(CNA_NOT_FOUND_MESSAGE "This shared CNA C++ SDK requires CMake 3.30 or newer")
    return()
endif()
include(CMakeFindDependencyMacro)
set(_cna_sdk_prefix "${PACKAGE_PREFIX_DIR}")
find_dependency(SharpRuntime @CNA_REQUIRED_SHARP_RUNTIME_VERSION@ CONFIG)
if(@CNA_PACKAGE_NEEDS_SDL@)
    find_dependency(SDL3 CONFIG)
endif()
if(@CNA_PACKAGE_NEEDS_MIXER@)
    find_dependency(SDL3_mixer CONFIG)
endif()
if(@CNA_PACKAGE_NEEDS_FREETYPE@)
    find_dependency(Freetype)
endif()
if(@CNA_PACKAGE_NEEDS_ZLIB@)
    find_dependency(ZLIB)
endif()
if(@CNA_PACKAGE_NEEDS_CURL@)
    find_dependency(CURL)
endif()
if(@CNA_PACKAGE_NEEDS_JSON@)
    find_dependency(nlohmann_json 3.11 CONFIG)
endif()
if(@CNA_PACKAGE_NEEDS_CROSS_JSON@ AND NOT TARGET CNA_JsonHeaders)
    add_library(CNA_JsonHeaders INTERFACE IMPORTED)
    set_target_properties(CNA_JsonHeaders PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_cna_sdk_prefix}/@CMAKE_INSTALL_INCLUDEDIR@/cna/dependencies/json")
endif()
if(@CNA_USE_SYSTEM_DRACO@)
    find_dependency(draco CONFIG)
endif()
if(@CNA_PACKAGE_NEEDS_FFMPEG@ OR @CNA_PACKAGE_NEEDS_OPUS@)
    find_dependency(PkgConfig)
    # Match find_dependency: QUIET discovery returns NOTFOUND rather than making
    # a consumer's optional find_package fatal. A macro's return exits this file.
    macro(_cna_sdk_pkg_dependency prefix module)
        pkg_check_modules(${prefix} QUIET IMPORTED_TARGET ${module})
        if(NOT ${prefix}_FOUND)
            set(CNA_FOUND FALSE)
            set(CNA_NOT_FOUND_MESSAGE "CNA requires pkg-config dependency ${module}")
            return()
        endif()
    endmacro()
    if(@CNA_PACKAGE_NEEDS_FFMPEG@)
        _cna_sdk_pkg_dependency(LIBAVCODEC libavcodec)
        _cna_sdk_pkg_dependency(LIBAVFORMAT libavformat)
        _cna_sdk_pkg_dependency(LIBAVUTIL libavutil)
        _cna_sdk_pkg_dependency(LIBSWRESAMPLE libswresample)
    endif()
    if(@CNA_PACKAGE_NEEDS_OPUS@)
        _cna_sdk_pkg_dependency(CNA_OPUS "opus>=1.3")
    endif()
endif()
if(@CNA_PACKAGE_NEEDS_ZSTD@ AND NOT TARGET CNA::Zstd)
    find_library(_cna_sdk_zstd NAMES zstd)
    if(NOT _cna_sdk_zstd)
        set(CNA_FOUND FALSE)
        set(CNA_NOT_FOUND_MESSAGE "CNA requires the zstd library")
        return()
    endif()
    add_library(CNA::Zstd UNKNOWN IMPORTED)
    set_target_properties(CNA::Zstd PROPERTIES IMPORTED_LOCATION "${_cna_sdk_zstd}")
endif()
if(@CNA_PACKAGE_NEEDS_SHADERC@ AND NOT TARGET CNA::Shaderc)
    find_library(_cna_sdk_shaderc NAMES shaderc_shared shaderc libshaderc.so.1)
    if(NOT _cna_sdk_shaderc)
        set(CNA_FOUND FALSE)
        set(CNA_NOT_FOUND_MESSAGE "CNA requires the shaderc library")
        return()
    endif()
    add_library(CNA::Shaderc UNKNOWN IMPORTED)
    set_target_properties(CNA::Shaderc PROPERTIES IMPORTED_LOCATION "${_cna_sdk_shaderc}")
endif()
if(@CNA_PACKAGE_NEEDS_WEBGPU@ AND NOT TARGET WebGPU::WebGPU)
    if(@EMSCRIPTEN@)
        add_library(WebGPU::WebGPU INTERFACE IMPORTED)
        set_target_properties(WebGPU::WebGPU PROPERTIES
            INTERFACE_COMPILE_OPTIONS "--use-port=emdawnwebgpu"
            INTERFACE_LINK_OPTIONS "--use-port=emdawnwebgpu")
    else()
        add_library(WebGPU::WebGPU SHARED IMPORTED)
        set_target_properties(WebGPU::WebGPU PROPERTIES
            IMPORTED_LOCATION "${_cna_sdk_prefix}/@CNA_PACKAGE_WEBGPU_LIBRARY@"
            INTERFACE_INCLUDE_DIRECTORIES "${_cna_sdk_prefix}/@CMAKE_INSTALL_INCLUDEDIR@/cna/dependencies/webgpu")
        if(NOT "@CNA_PACKAGE_WEBGPU_IMPLIB@" STREQUAL "")
            set_target_properties(WebGPU::WebGPU PROPERTIES
                IMPORTED_IMPLIB "${_cna_sdk_prefix}/@CNA_PACKAGE_WEBGPU_IMPLIB@")
        else()
            set_target_properties(WebGPU::WebGPU PROPERTIES IMPORTED_NO_SONAME TRUE)
        endif()
    endif()
endif()
if(@CNA_SHARED_LIBRARY@)
    set(CMAKE_LINK_LIBRARY_USING_cna_shared_needed
        "LINKER:--push-state,--no-as-needed" "<LINK_ITEM>" "LINKER:--pop-state"
        CACHE INTERNAL "CNA shared-runtime consumer link feature" FORCE)
    set(CMAKE_LINK_LIBRARY_USING_cna_shared_needed_SUPPORTED TRUE
        CACHE INTERNAL "CNA shared-runtime consumer link feature support" FORCE)
    set(CMAKE_LINK_LIBRARY_cna_shared_needed_ATTRIBUTES "LIBRARY_TYPE=SHARED;OVERRIDE=DEFAULT"
        CACHE INTERNAL "CNA shared-runtime consumer link feature attributes" FORCE)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CNACppTargets.cmake")
set_target_properties(CNA::CNA PROPERTIES CNA_INSTALLED_SDK TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/CxxRuntimeLinkage.cmake")
cna_add_cxx_runtime_first_link_option(CNA::BuildConfig)
cna_add_cxx_runtime_first_link_option(CNA::CNA)
include("${CMAKE_CURRENT_LIST_DIR}/DeployRuntime.cmake")
if(NOT TARGET CNA)
    add_library(CNA INTERFACE IMPORTED)
    set_target_properties(CNA PROPERTIES INTERFACE_LINK_LIBRARIES CNA::CNA)
endif()
if(TARGET CNA::CApi AND TARGET CNA::Shared)
    # C and C++ used together must activate the same early shared-runtime link
    # contract as the source-tree umbrella, regardless of consumer link order.
    set_property(TARGET CNA::CApi APPEND PROPERTY INTERFACE_LINK_LIBRARIES CNA::CNA)
endif()
