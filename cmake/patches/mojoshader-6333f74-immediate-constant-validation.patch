+static ConstantsList *find_constant_listitem(Context *ctx,
+                                             const MOJOSHADER_uniformType type,
+                                             const int index)
+{
+    ConstantsList *item = ctx->constants;
+    while (item != NULL)
+    {
+        if ((item->constant.type == type) && (item->constant.index == index))
+            return item;
+        item = item->next;
+    } // while
+    return NULL;
+} // find_constant_listitem
