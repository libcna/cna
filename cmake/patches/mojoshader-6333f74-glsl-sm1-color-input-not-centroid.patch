diff --git a/mojoshader_opengl.c b/mojoshader_opengl.c
--- a/mojoshader_opengl.c
+++ b/mojoshader_opengl.c
@@ -848,10 +848,16 @@
 } // glsl_input_is_unmatched
 
 
-static int glsl_attribute_uses_centroid(const MOJOSHADER_attribute *attribute)
+static int glsl_attribute_uses_centroid(const MOJOSHADER_parseData *ppd,
+                                        const MOJOSHADER_attribute *attribute)
 {
-    return ((attribute->flags & 0x4) != 0) ||
-           (attribute->usage == MOJOSHADER_USAGE_COLOR);
+    /* The pixel-shader emitter declares an input centroid only from Shader Model 2.0 up
+     * (shader_version_atleast(ctx, 2, 0)): a 1.x pixel shader reads its colour as the plain
+     * io_<usage>_<index>, so its vertex shader must keep writing that name. Deciding by usage
+     * alone renamed the vertex output and the pair failed to link. -CNA */
+    return (ppd->major_ver >= 2) &&
+           (((attribute->flags & 0x4) != 0) ||
+            (attribute->usage == MOJOSHADER_USAGE_COLOR));
 } // glsl_attribute_uses_centroid
 
 
@@ -871,7 +877,7 @@
 
