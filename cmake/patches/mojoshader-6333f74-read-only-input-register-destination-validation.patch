+static void validate_input_register_destination(Context *ctx,
+                                                const uint32 opcode)
+{
+    if (!ctx->have_dest_arg || (opcode == 31))  // DCL describes an input; it does not write it.
+        return;
+
+    const RegisterType regtype = ctx->dest_arg.regtype;
+    if (regtype == REG_TYPE_INPUT)
+    {
+        fail(ctx, "input registers are read-only instruction operands");
+    } // if
+    else if (shader_is_pixel(ctx) && (ctx->major_ver >= 2) &&
+             (regtype == REG_TYPE_TEXTURE))
+    {
+        fail(ctx, "pixel texture-coordinate input registers are read-only");
+    } // else if
+} // validate_input_register_destination
