diff --git a/mojoshader.c b/mojoshader.c
--- a/mojoshader.c
+++ b/mojoshader.c
@@ -393,6 +393,37 @@
     } // else
 } // validate_input_register
 
+static void validate_output_register(Context *ctx, const RegisterType regtype,
+                                     const int regnum)
+{
+    if (shader_is_vertex(ctx))
+    {
+        if (shader_version_atleast(ctx, 3, 0))
+        {
+            if ((regtype == REG_TYPE_OUTPUT) && (regnum >= 12))
+                failf(ctx, "vertex output register o%d is out of range", regnum);
+        } // if
+        else
+        {
+            if ((regtype == REG_TYPE_RASTOUT) && (regnum >= 3))
+                fail(ctx, "vertex raster output register is out of range");
+            else if ((regtype == REG_TYPE_ATTROUT) && (regnum >= 2))
+                failf(ctx, "vertex color output register oD%d is out of range", regnum);
+            else if ((regtype == REG_TYPE_TEXCRDOUT) && (regnum >= 8))
+                failf(ctx, "vertex texture output register oT%d is out of range", regnum);
+        } // else
+        return;
+    } // if
+
+    if (shader_is_pixel(ctx))
+    {
+        if ((regtype == REG_TYPE_COLOROUT) && (regnum >= 4))
+            failf(ctx, "pixel color output register oC%d is out of range", regnum);
+        else if ((regtype == REG_TYPE_DEPTHOUT) && (regnum >= 1))
+            fail(ctx, "pixel depth output register is out of range");
+    } // if
+} // validate_output_register
+
 #undef DEFINE_PROFILE
 
 // This is for profiles that extend other profiles...
@@ -467,6 +498,7 @@
 
     validate_temporary_register(ctx, info->regtype, info->regnum);
     validate_input_register(ctx, info->regtype, info->regnum);
+    validate_output_register(ctx, info->regtype, info->regnum);
 
     // swallow token for now, for multiple calls in a row.
     adjust_token_position(ctx, 1);
