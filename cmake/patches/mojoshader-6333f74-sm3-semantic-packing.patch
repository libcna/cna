+                get_GLSL_writemask_suffix(item->writemask, mask, sizeof (mask));
+                if ((item->usage == MOJOSHADER_USAGE_POINTSIZE) && (item->index == 0))
+                    output_line(ctx, "%s = %s.x;", semantic, reg);
+                else if (item->usage == MOJOSHADER_USAGE_COLOR)
