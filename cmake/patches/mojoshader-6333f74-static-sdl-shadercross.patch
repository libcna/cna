+    if (SDL_ShaderCross_ReflectGraphicsSPIRV == NULL ||
+        SDL_ShaderCross_CompileGraphicsShaderFromSPIRV == NULL)
+        return 0;
+    ctx->use_shadercross = 1;
+    return 1;
