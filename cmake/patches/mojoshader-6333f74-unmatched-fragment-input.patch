+static int glsl_input_is_unmatched(const MOJOSHADER_parseData *vpd,
+                                   const MOJOSHADER_attribute *attribute)
+{
+    int i;
+    for (i = 0; i < vpd->output_count; i++)
+    {
+        if ((vpd->outputs[i].usage == attribute->usage) &&
+            (vpd->outputs[i].index == attribute->index))
+            return 0;
+    } // for
+    return 1;
+} // glsl_input_is_unmatched
+
+
+static char *glsl_source_without_unmatched_inputs(const MOJOSHADER_parseData *vpd,
+                                                  const MOJOSHADER_parseData *ppd)
+{
+    int i;
+    int unmatched = 0;
+    const char *src;
+    const char *end;
+    char *retval;
+    char *dst;
+
+    if ((vpd == NULL) || (ppd == NULL) || (ppd->output == NULL) || (ppd->output_len <= 0))
+        return NULL;
+    if (ppd->shader_type != MOJOSHADER_TYPE_PIXEL)
+        return NULL;
+    if ((ppd->attribute_count <= 0) || (ppd->attributes == NULL))
+        return NULL;
+    if ((vpd->output_count < 0) || ((vpd->output_count > 0) && (vpd->outputs == NULL)))
+        return NULL;
+
+    for (i = 0; i < ppd->attribute_count; i++)
+    {
+        if (glsl_input_is_unmatched(vpd, &ppd->attributes[i]))
+            unmatched++;
+    } // for
+
+    if (unmatched == 0)
+        return NULL;
+
+    /* " = ivec4(0)" is the longest initializer inserted, and dropping the storage qualifier only
+     * ever shortens a line, so the original length plus one initializer per unmatched input is a
+     * safe bound. */
+    retval = (char *) Malloc(((size_t) ppd->output_len) + (((size_t) unmatched) * 16) + 1);
+    if (retval == NULL)
+        return NULL;
+
+    src = ppd->output;
+    end = src + ppd->output_len;
+    dst = retval;
+
+    while (src < end)
+    {
+        const char *line = src;
+        const char *linend = line;
+        const char *decl = line;
+        const char *name = NULL;
+        const char *type = NULL;
+        size_t namelen = 0;
+        size_t typelen = 0;
+        const char *cursor;
+        int rewrite = 0;
+
+        while ((linend < end) && (*linend != '\n'))
+            linend++;
+
+        /* A declaration this rewrite applies to is a whole line of the profile's own making: a
+         * storage qualifier, an optional precision qualifier, a type, and the io_<usage>_<index>
+         * name the emitter derives from the semantic. Anything else is copied through untouched. */
+        if ((((size_t) (linend - line)) > 3) && (strncmp(line, "in ", 3) == 0))
+            decl = line + 3;
+        else if ((((size_t) (linend - line)) > 8) && (strncmp(line, "varying ", 8) == 0))
+            decl = line + 8;
+
+        if (decl != line)
+        {
+            /* the last two whitespace-delimited tokens are the type and the variable name */
+            cursor = decl;
+            while (cursor < linend)
+            {
+                const char *token;
+                while ((cursor < linend) && (*cursor == ' '))
+                    cursor++;
+                if (cursor >= linend)
+                    break;
+                token = cursor;
+                while ((cursor < linend) && (*cursor != ' '))
+                    cursor++;
+                type = name;
+                typelen = namelen;
+                name = token;
+                namelen = (size_t) (cursor - token);
+            } // while
+        } // if
+
+        if ((name != NULL) && (type != NULL) && (namelen > 4) &&
+            (strncmp(name, "io_", 3) == 0) && (name[namelen - 1] == ';'))
+        {
+            int usage = -1;
+            int index = -1;
+            if (glsl_parse_io_name(name, namelen, &usage, &index))
+            {
+                for (i = 0; i < ppd->attribute_count; i++)
+                {
+                    if (((int) ppd->attributes[i].usage != usage) ||
+                        (ppd->attributes[i].index != index))
+                        continue;
+                    rewrite = glsl_input_is_unmatched(vpd, &ppd->attributes[i]);
+                    break;
+                } // for
+            } // if
+        } // if
+
+        if (rewrite)
+        {
+            /* everything from the type up to, but not including, the terminating semicolon */
+            const size_t declaration = (size_t) ((name + namelen - 1) - decl);
+            memcpy(dst, decl, declaration);
+            dst += declaration;
+            if ((typelen == 5) && (strncmp(type, "float", 5) == 0))
+                dst = glsl_append(dst, " = 0.0;", 7);
+            else
+            {
+                const char *zero = "(0.0);";
+                size_t zerolen = 6;
+                if ((typelen > 4) && (strncmp(type, "ivec", 4) == 0))
+                {
+                    zero = "(0);";
+                    zerolen = 4;
+                } // if
+                else if ((typelen > 4) && (strncmp(type, "uvec", 4) == 0))
+                {
+                    zero = "(0u);";
+                    zerolen = 5;
+                } // else if
+                dst = glsl_append(dst, " = ", 3);
+                dst = glsl_append(dst, type, typelen);
+                dst = glsl_append(dst, zero, zerolen);
+            } // else
+        } // if
+        else
+        {
+            memcpy(dst, line, (size_t) (linend - line));
+            dst += (linend - line);
+        } // else
+
+        if (linend < end)
+            *(dst++) = *(linend++);
+        src = linend;
+    } // while
+
+    *dst = '\0';
+    return retval;
+} // glsl_source_without_unmatched_inputs
