+/* Direct3D 9 links a vertex and a pixel shader by REGISTER, so a pixel shader may read an input
+ * its vertex shader never writes; the value is simply undefined. GLSL links by NAME and refuses
+ * the pair outright ("fragment shader input `io_5_0' has no matching output in the previous
+ * stage"). Point-sprite shaders reach this routinely -- the pixel shader reads TEXCOORD0 because
+ * Direct3D generated it in the rasterizer, so no vertex shader ever declares it -- and an effect
+ * that pairs one pixel shader with several vertex shaders can reach it for one pairing and not
+ * another.
+ *
+ * Give those inputs a producer-free definition instead: a zero-initialised global reads as a
+ * defined value in GLSL and leaves every other declaration, uniform and sampler exactly where the
+ * profile put it. Which inputs are unmatched is decided by the PAIRING, not by the shader, so the
+ * rewritten source belongs to this link; the caller compiles it into a temporary shader object
+ * and deletes it once the program has linked.
+ *
+ * Returns NULL when nothing needs rewriting -- overwhelmingly the common case -- and also on
+ * failure, where the caller links the source as emitted and GL reports whatever it reports. -CNA
+ */
+static char *glsl_append(char *dst, const char *text, const size_t len)
+{
+    memcpy(dst, text, len);
+    return dst + len;
+} // glsl_append
+
+
+/* "io_<usage>_<index>;", exactly as the GLSL profile emits a varying's name. */
+static int glsl_parse_io_name(const char *name, const size_t namelen, int *usage, int *index)
+{
+    size_t i = 3;  /* past "io_" */
+    int values[2] = { 0, 0 };
+    int which;
+
+    for (which = 0; which < 2; which++)
+    {
+        const size_t first = i;
+        while ((i < namelen) && (name[i] >= '0') && (name[i] <= '9'))
+        {
+            if (values[which] > ((0x7FFFFFFF - 9) / 10))
+                return 0;
+            values[which] = (values[which] * 10) + (name[i] - '0');
+            i++;
+        } // while
+        if (i == first)
+            return 0;
+        if (name[i] != ((which == 0) ? '_' : ';'))
+            return 0;
+        i++;
+    } // for
+
+    if (i != namelen)
+        return 0;
+
+    *usage = values[0];
+    *index = values[1];
+    return 1;
+} // glsl_parse_io_name
