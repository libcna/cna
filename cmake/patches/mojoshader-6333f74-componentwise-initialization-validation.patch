+static int opcode_reads_sources_componentwise(const uint32 opcode)
+{
+    switch (opcode)
+    {
+        case 1:  // MOV
+        case 2:  // ADD
+        case 3:  // SUB
+        case 4:  // MAD
+        case 5:  // MUL
+        case 10: // MIN
+        case 11: // MAX
+        case 12: // SLT
+        case 13: // SGE
+        case 18: // LRP
+        case 19: // FRC
+        case 35: // ABS
+        case 88: // CMP
+        case 91: // DSX
+        case 92: // DSY
+            return 1;
+        default:
+            return 0;
+    } // switch
+} // opcode_reads_sources_componentwise
