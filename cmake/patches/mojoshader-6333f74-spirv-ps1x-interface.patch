+
     push_output(ctx, &ctx->mainline_intro);
     spv_emit(ctx, 4, SpvOpVariable, tid, r->spirv.iddecl, sc);
     pop_output(ctx);
 
     spv_output_regname(ctx, r->spirv.iddecl, regtype, regnum);
 } // emit_SPIRV_global
