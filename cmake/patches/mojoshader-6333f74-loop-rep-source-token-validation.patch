diff --git a/mojoshader.c b/mojoshader.c
index e0e684f..b43710a 100644
--- a/mojoshader.c
+++ b/mojoshader.c
@@ -2828,12 +2828,20 @@ static int flow_control_block_is_if(const FlowControlBlock block)
 
 static void state_LOOP(Context *ctx)
 {
+    const SourceArgInfo *loopreg = &ctx->source_args[0];
+    const SourceArgInfo *constant = &ctx->source_args[1];
     if (shader_is_pixel(ctx) && !shader_version_atleast(ctx, 3, 0))
         fail(ctx, "LOOP not supported in pixel Shader Model 2.x");
-    else if (ctx->source_args[0].regtype != REG_TYPE_LOOP)
+    else if (loopreg->regtype != REG_TYPE_LOOP)
         fail(ctx, "LOOP argument isn't loop register");
-    else if (ctx->source_args[1].regtype != REG_TYPE_CONSTINT)
+    else if (constant->regtype != REG_TYPE_CONSTINT)
         fail(ctx, "LOOP argument isn't constint register");
+    else if ((loopreg->src_mod != SRCMOD_NONE) ||
+             (constant->src_mod != SRCMOD_NONE))
+        fail(ctx, "LOOP sources must not have modifiers");
+    else if (!no_swizzle(loopreg->swizzle) ||
+             !no_swizzle(constant->swizzle))
+        fail(ctx, "LOOP sources must have identity swizzles");
     else if (push_flow_control_block(ctx, FLOW_CONTROL_BLOCK_LOOP))
     {
         ctx->loops++;
@@ -2895,12 +2903,23 @@ static void state_SETP(Context *ctx)
 
 static void state_REP(Context *ctx)
 {
-    const RegisterType regtype = ctx->source_args[0].regtype;
+    const SourceArgInfo *constant = &ctx->source_args[0];
+    const RegisterType regtype = constant->regtype;
     if (regtype != REG_TYPE_CONSTINT)
     {
         fail(ctx, "REP argument isn't constint register");
         return;
     } // if
+    else if (constant->src_mod != SRCMOD_NONE)
+    {
+        fail(ctx, "REP source must not have a modifier");
+        return;
+    } // else if
+    else if (!no_swizzle(constant->swizzle))
+    {
+        fail(ctx, "REP source must have identity swizzle");
+        return;
+    } // else if
 
     if (!push_flow_control_block(ctx, FLOW_CONTROL_BLOCK_REP))
         return;
