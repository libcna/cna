+static void validate_pixel_shader_model_one_coissue_opcode(
+    Context *ctx, const uint32 opcode)
+{
+    if (!shader_is_pixel(ctx) || (ctx->major_ver != 1) || !ctx->coissue)
+        return;
+
+    if (pixel_shader_model_one_texture_opcode(opcode))
+    {
+        fail(ctx, "pixel Shader Model 1.x texture instructions cannot be co-issued");
+    } // if
+    else if (opcode == 9)  // DP4 occupies both the RGB and alpha pipelines.
+    {
+        fail(ctx, "pixel Shader Model 1.x DP4 cannot be co-issued");
+    } // else if
+} // validate_pixel_shader_model_one_coissue_opcode
