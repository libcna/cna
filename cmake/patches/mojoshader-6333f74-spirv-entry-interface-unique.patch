+/* Appends one <id> to an OpEntryPoint interface list, ignoring an <id> already in it.
+ * SPIR-V requires the interface to name each variable exactly once, and more than one of
+ * MojoShader's own bookkeeping lists can reach the same variable. -CNA */
+static void spv_add_interface_id(Context *ctx, uint32 id, uint32 *ids, uint32 *count,
+                                 uint32 max)
+{
+    uint32 i;
+
+    if (id == 0)
+        return;
+
+    for (i = 0; i < *count; i++)
+    {
+        if (ids[i] == id)
+            return;
+    } // for
+
+    if (*count >= max)
+    {
+        fail(ctx, "BUG: entry point interface is larger than its own upper bound");
+        return;
+    } // if
+
+    ids[(*count)++] = id;
+} // spv_add_interface_id
