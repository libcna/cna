     const char *rightparen = (need_parens) ? ")" : "";
 
+    if (ctx->predicated)
+    {
+        const int vecsize = vecsize_from_writemask(arg->writemask);
+        const SourceArgInfo *predicate = &ctx->predicate_arg;
