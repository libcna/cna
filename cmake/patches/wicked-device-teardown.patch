+		// The command lists are placement-allocated from cmd_allocator, so the vector alone does
+		// not run their destructors. Freeing them here releases every per-frame linear allocator
+		// buffer, bound-resource table entry and worker pipeline they still reference; otherwise
+		// those keep the allocationhandler (and with it the VmaAllocator, VkDevice and VkInstance)
+		// alive past device destruction.
+		for (auto& commandlist : commandlists)
+		{
+			cmd_allocator.free(commandlist);
+		}
+		commandlists.clear();
 
 		for (auto& x : semaphore_pool)
