 /* Renderer Implementation */
 
+/* CNA: every device owns a GL context and a MojoShader context, and MojoShader's is a process-wide
+ * current pointer. Each entry point makes its own device's pair current, so several live devices
+ * on one thread neither draw into nor delete from each other's contexts. A call from another
+ * thread changes nothing here: the entry point forwards it to the device's own thread.
+ */
+static inline OpenGLRenderer* OPENGL_INTERNAL_Activate(FNA3D_Renderer *driverData)
+{
+	OpenGLRenderer *renderer = (OpenGLRenderer*) driverData;
+	if (renderer->threadID == SDL_GetCurrentThreadID())
+	{
+		if (SDL_GL_GetCurrentContext() != renderer->context)
+		{
+			SDL_GL_MakeCurrent(renderer->window, renderer->context);
+		}
+		MOJOSHADER_glMakeContextCurrent(renderer->shaderContext);
+	}
+	return renderer;
+}
+
