 } // state_TEXDEPTH
 
 
 static void state_TEXLD(Context *ctx)
 {
@@ -3147,6 +3216,12 @@ static void state_TEXLD(Context *ctx)
         else if ((src->regtype != REG_TYPE_TEXTURE) &&
