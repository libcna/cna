+++ b/profiles/mojoshader_profile_spirv.c
@@ -1427,6 +1427,28 @@
         value.id = new_value;
     } // if
 
+    // Direct3D 9 clamps a vertex shader's colour output registers (oD#) to [0,1] before the
+    // rasterizer interpolates them; a SPIR-V output is clamped nowhere -- the GLSL and Metal
+    // profiles' gap, closed the same way (vertex-color-clamp). oD# is write-only, so clamping
+    // every value stored into it clamps the final one. -CNA
+    if ((reg->regtype == REG_TYPE_ATTROUT) && shader_is_vertex(ctx))
+    {
+        uint32 ext, zero, one, clamped;
+
+        // Don't inline these, compilers will run the varargs in different orders
+        clamped = spv_bumpid(ctx);
+        one = spv_get_one(ctx, value.tid);
+        zero = spv_get_zero(ctx, value.tid);
+        ext = spv_getext(ctx);
+
+        push_output(ctx, &ctx->mainline);
+        spv_emit(ctx, 5 + 3, SpvOpExtInst,
+            value.tid, clamped, ext, GLSLstd450FClamp, value.id, zero, one
+        );
+        pop_output(ctx);
+        value.id = clamped;
+    } // if
+
