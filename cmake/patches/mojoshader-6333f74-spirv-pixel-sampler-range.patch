diff --git a/profiles/mojoshader_profile_spirv.c b/profiles/mojoshader_profile_spirv.c
index 34db3b3..95721cd 100644
--- a/profiles/mojoshader_profile_spirv.c
+++ b/profiles/mojoshader_profile_spirv.c
@@ -2297,7 +2297,14 @@ void emit_SPIRV_sampler(Context *ctx, int stage, TextureType ttype, int texbem)
         return;
     } // if
     if ((stage < 0) ||
-        (((size_t) stage) >= STATICARRAYLEN(ctx->spirv.sampler_extras)))
+        /* sampler_extras has four entries because it stores TEXBEM data, which exists only in
