get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/FfmpegFeatureProbe")

function(check_case video audio supported missing expected_video expected_audio)
    set(CNA_ENABLE_VIDEO "${video}")
    set(CNA_ENABLE_WAVEBANK_CODECS "${audio}")
    set(WIN32 FALSE)
    set(MINGW FALSE)
    set(EMSCRIPTEN FALSE)
    set(ANDROID FALSE)
    set(CNA_APPLE_IOS FALSE)
    if(NOT supported)
        set(EMSCRIPTEN TRUE)
    endif()
    set(GAP05_FIND_CALLS 0)
    set(GAP05_MODULE_CALLS 0)
    set(GAP05_MISSING_MODULE "${missing}")
    set(GAP05_FORBID_PROBE FALSE)
    if(NOT supported OR (video STREQUAL "OFF" AND audio STREQUAL "OFF"))
        set(GAP05_FORBID_PROBE TRUE)
    endif()
    include("${_root}/cmake/FFmpegFeatures.cmake")
    if(NOT CNA_FFMPEG_AVAILABLE STREQUAL expected_video OR
       NOT CNA_WAVEBANK_FFMPEG_AVAILABLE STREQUAL expected_audio)
        message(FATAL_ERROR "Wrong feature result: video=${video} audio=${audio}, ${CNA_FFMPEG_AVAILABLE}/${CNA_WAVEBANK_FFMPEG_AVAILABLE}")
    endif()
    if(GAP05_FORBID_PROBE)
        if(NOT GAP05_FIND_CALLS EQUAL 0 OR NOT GAP05_MODULE_CALLS EQUAL 0)
            message(FATAL_ERROR "Disabled/unsupported consumers must not discover host libraries")
        endif()
    elseif(NOT GAP05_FIND_CALLS EQUAL 1 OR NOT GAP05_MODULE_CALLS EQUAL 4)
        message(FATAL_ERROR "Consumers did not share one four-module FFmpeg discovery")
    endif()
endfunction()

if(DEFINED GAP05_FAILURE_CASE)
    if(GAP05_FAILURE_CASE STREQUAL "video_missing")
        check_case(ON OFF TRUE libswresample ON OFF)
    elseif(GAP05_FAILURE_CASE STREQUAL "audio_missing")
        check_case(OFF ON TRUE libavcodec OFF ON)
    elseif(GAP05_FAILURE_CASE STREQUAL "video_cross")
        check_case(ON OFF FALSE "" OFF OFF)
    elseif(GAP05_FAILURE_CASE STREQUAL "audio_cross")
        check_case(OFF ON FALSE "" OFF OFF)
    endif()
    message(FATAL_ERROR "Expected required/unsupported selection to fail")
endif()

# Independent public switches: turning video off must leave requested audio on,
# and turning audio off must leave requested video on. Both off must not probe.
foreach(video IN ITEMS OFF AUTO ON)
    foreach(audio IN ITEMS OFF AUTO ON)
        set(ev ON)
        set(ea ON)
        if(video STREQUAL "OFF")
            set(ev OFF)
        endif()
        if(audio STREQUAL "OFF")
            set(ea OFF)
        endif()
        check_case("${video}" "${audio}" TRUE "" "${ev}" "${ea}")
    endforeach()
endforeach()
check_case(AUTO AUTO TRUE libavutil OFF OFF)
check_case(OFF AUTO TRUE libavformat OFF OFF)
check_case(AUTO OFF FALSE "" OFF OFF)
check_case(OFF AUTO FALSE "" OFF OFF)
check_case(AUTO AUTO FALSE "" OFF OFF)
foreach(failure IN ITEMS video_missing audio_missing video_cross audio_cross)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DGAP05_FAILURE_CASE=${failure}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0)
        message(FATAL_ERROR "${failure} accepted an unavailable required feature")
    endif()
    if(failure MATCHES "cross$" AND NOT error MATCHES "not supported by this target toolchain")
        message(FATAL_ERROR "${failure} failed for the wrong reason: ${error}")
    elseif(failure MATCHES "missing$" AND NOT error MATCHES "Required FFmpeg dependency")
        message(FATAL_ERROR "${failure} failed for the wrong reason: ${error}")
    endif()
endforeach()
message(STATUS "GAP-05: independent feature switches, shared discovery, absent dependencies and cross-target refusal passed")
