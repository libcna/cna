# GAP-13: a green process with no selected tests (or only skips) cannot qualify a renderer.
cmake_minimum_required(VERSION 3.20)
foreach(_argument CNA_EXECUTABLE CNA_FILTER CNA_REPORT CNA_EXPECTED_CASES)
    if(NOT DEFINED ${_argument})
        message(FATAL_ERROR "Missing ${_argument}")
    endif()
endforeach()
if(NOT CNA_EXPECTED_CASES MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "GAP-13 requires a positive expected test count")
endif()
file(REMOVE "${CNA_REPORT}")
set(_native_report "${CNA_REPORT}")
if(CNA_WINE)
    # The existing Wine runner exposes the host root as Z:, not C:/rv.
    set(_native_report "Z:${CNA_REPORT}")
endif()
set(_command "${CNA_EXECUTABLE}" ${CNA_ARGUMENTS})
if(CNA_LAUNCHER)
    list(PREPEND _command "${CNA_LAUNCHER}")
endif()
execute_process(COMMAND ${_command} "--gtest_filter=${CNA_FILTER}"
    "--gtest_output=xml:${_native_report}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
message("${_output}${_error}")
if(NOT "${_result}" STREQUAL "0")
    message(FATAL_ERROR "GAP-13 selected tests returned ${_result}")
endif()
if(NOT EXISTS "${CNA_REPORT}")
    message(FATAL_ERROR "GAP-13 produced no test inventory")
endif()
file(READ "${CNA_REPORT}" _xml)
string(REGEX MATCHALL "<testcase[ \t\r\n]" _cases "${_xml}")
list(LENGTH _cases _count)
if(NOT _count EQUAL CNA_EXPECTED_CASES OR _xml MATCHES "<(skipped|failure|error)[ />]"
   OR _xml MATCHES "status=\"notrun\"")
    message(FATAL_ERROR "GAP-13 requires ${CNA_EXPECTED_CASES} executed passing cases, zero skipped; inventory=${_count}")
endif()
message(STATUS "GAP-13 qualified ${_count}/${CNA_EXPECTED_CASES} selected cases without skips")
