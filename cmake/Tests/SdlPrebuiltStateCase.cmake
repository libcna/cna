# BUILD-D1: inspect the real CHECK path without configuring or building SDL.
# cmake -DCNA_SOURCE_DIR=<repo> -DCNA_WORK_DIR=<scratch> -P cmake/Tests/SdlPrebuiltStateCase.cmake
cmake_minimum_required(VERSION 3.20)

foreach(_required IN ITEMS CNA_SOURCE_DIR CNA_WORK_DIR)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "SdlPrebuiltStateCase.cmake requires -D${_required}=...")
    endif()
endforeach()

set(EMSCRIPTEN TRUE) # Avoid host video-driver discovery during include.
include("${CNA_SOURCE_DIR}/cmake/ThirdPartySDL.cmake")

# Fingerprint generation has its own suite; isolate the install decision here.
function(cna_sdl_parent_configure_args out)
    set(${out} "" PARENT_SCOPE)
endfunction()
function(cna_sdl_toolchain_settings out)
    set(${out} "" PARENT_SCOPE)
endfunction()
function(cna_sdl_build_manifest out)
    set(${out} "${_fixture_manifest}" PARENT_SCOPE)
endfunction()

macro(_layout kind)
    set(EMSCRIPTEN FALSE)
    set(ANDROID FALSE)
    set(WIN32 FALSE)
    set(APPLE FALSE)
    set(MSVC FALSE)
    set(CNA_APPLE_IOS FALSE)
    if("${kind}" STREQUAL "wasm")
        set(EMSCRIPTEN TRUE)
    elseif("${kind}" STREQUAL "windows")
        set(WIN32 TRUE)
    elseif("${kind}" STREQUAL "macos")
        set(APPLE TRUE)
    endif()
    _cna_sdl_set_layout("${_root}")
endmacro()

set(_passed 0)
set(_failed 0)
macro(_expect label expected)
    foreach(_name IN ITEMS SDL3 SDL3_mixer)
        if(_name STREQUAL "SDL3")
            set(_library "${_sdl3_lib}")
        else()
            set(_library "${_sdl_mixer_lib}")
        endif()
        _cna_ensure_sdl_dep(CHECK DIR "${_root}" NAME "${_name}"
            LIBRARY "${_library}" SOURCE unused
            STATE_VAR _state MANIFEST_VAR _returned_manifest)
        if(_state STREQUAL "${expected}" AND _returned_manifest STREQUAL _fixture_manifest)
            math(EXPR _passed "${_passed} + 1")
            message(STATUS "PASS: ${label} ${_name}: ${_state}")
        else()
            math(EXPR _failed "${_failed} + 1")
            message(STATUS "FAIL: ${label} ${_name}: expected ${expected}, got ${_state}")
        endif()
    endforeach()
endmacro()

# Exercise every supported library filename in both directions, including native/shared
# versus wasm/static. A same-layout manifest change must keep the established policy too.
foreach(_installed IN ITEMS native wasm windows macos)
    set(_root "${CNA_WORK_DIR}/complete-${_installed}")
    file(REMOVE_RECURSE "${_root}")
    _layout("${_installed}")
    file(WRITE "${_sdl3_lib}" "SDL fixture\n")
    file(WRITE "${_sdl_mixer_lib}" "mixer fixture\n")
    foreach(_name IN ITEMS SDL3 SDL3_mixer)
        file(WRITE "${_root}/${_name}.cna-build-manifest.txt" "${_installed} manifest\n")
    endforeach()
    set(_fixture_manifest "${_installed} manifest\n")
    _expect("${_installed} same manifest" current)
    foreach(_incoming IN ITEMS native wasm windows macos)
        _layout("${_incoming}")
        set(_fixture_manifest "new ${_incoming} manifest\n")
        _expect("${_installed} -> ${_incoming} foreign manifest" other)
    endforeach()
endforeach()

set(_root "${CNA_WORK_DIR}/incomplete")
file(REMOVE_RECURSE "${_root}")
file(MAKE_DIRECTORY "${_root}")
_layout(native)
set(_fixture_manifest "native manifest\n")
_expect("empty root" absent)
file(WRITE "${_sdl3_lib}" "partial SDL fixture\n")
file(WRITE "${_sdl_mixer_lib}" "partial mixer fixture\n")
_expect("library without completion stamp" absent)
_layout(wasm)
_expect("foreign library without completion stamp" absent)
_layout(native)
file(REMOVE "${_sdl3_lib}" "${_sdl_mixer_lib}")
foreach(_name IN ITEMS SDL3 SDL3_mixer)
    file(WRITE "${_root}/${_name}.cna-build-manifest.txt" "${_fixture_manifest}")
endforeach()
_expect("same manifest with missing library" absent)
set(_fixture_manifest "different manifest\n")
_expect("foreign completion stamp with missing library" other)

message(STATUS "SdlPrebuiltStateCase: ${_passed} passed, ${_failed} failed, 0 skipped")
if(_failed)
    message(FATAL_ERROR "BUILD-D1: SDL prebuilt state classification failed")
endif()
