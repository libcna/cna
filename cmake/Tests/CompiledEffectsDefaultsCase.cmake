# GAP-13: evaluate real declarations against an independent release policy.
cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED CNA_SOURCE_DIR)
    message(FATAL_ERROR "CNA_SOURCE_DIR is required")
endif()
if(NOT DEFINED CNA_EXPECT_PROMOTED)
    set(CNA_EXPECT_PROMOTED "")
endif()
file(READ "${CNA_SOURCE_DIR}/cmake/RendererSelection.cmake" _source)
set(_policy_source "${_source}")
# Flatten whitespace before matching quoted option declarations.
string(REGEX REPLACE "[\n\r\t]" " " _source "${_source}")
foreach(_family EASYGL WEBGPU SOFTWARE DIRECTX9 SDLGPU)
    set(_option "CNA_${_family}_COMPILED_EFFECTS")
    set(_pattern [=[option\(@OPTION@ +"[^"]*" +(ON|OFF|[$][{]_cna_easygl_compiled_default[}])\)]=])
    string(REPLACE "@OPTION@" "${_option}" _pattern "${_pattern}")
    string(REGEX MATCHALL "${_pattern}" _declarations "${_source}")
    list(LENGTH _declarations _count)
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one declaration for ${_option}, got ${_count}")
    endif()
    list(GET _declarations 0 _declaration)
    if(_family STREQUAL "EASYGL")
        string(REGEX MATCH "# GAP13_EASYGL_DEFAULT_BEGIN(.*)# GAP13_EASYGL_DEFAULT_END" _block "${_policy_source}")
        if(NOT _block)
            message(FATAL_ERROR "Qualified desktop default policy block is missing")
        endif()
        set(_policy "${CMAKE_MATCH_1}")
        # Literal expected values are independent of the production selector. A mixed
        # EasyGL binary has one shared flag, so any unqualified ES/browser identity keeps it OFF.
        set(_cases "OPENGL33|ON" "OPENGLES3|OFF" "WEBGL2|OFF"
            "OPENGL33,DIRECTX9|ON" "DIRECTX9,OPENGL33|ON"
            "OPENGL33,OPENGLES3|OFF" "OPENGLES3,OPENGL33|OFF"
            "OPENGL33,WEBGL2|OFF" "WEBGL2,OPENGL33|OFF"
            "OPENGLES3,WEBGL2|OFF" "OPENGL33,OPENGLES3,WEBGL2|OFF"
            "SOFTWARE|OFF")
        foreach(_case IN LISTS _cases)
            string(REPLACE "|" ";" _parts "${_case}")
            list(GET _parts 0 _identities)
            list(GET _parts 1 _expected)
            string(REPLACE "," ";" CNA_RENDERER_IDENTITIES "${_identities}")
            unset(_cna_easygl_compiled_default)
            cmake_language(EVAL CODE "${_policy}")
            unset(${_option})
            unset(${_option} CACHE)
            cmake_language(EVAL CODE "${_declaration}")
            if(NOT "${${_option}}" STREQUAL "${_expected}")
                message(FATAL_ERROR "${_option} default for ${_identities} is ${${_option}}, expected ${_expected}")
            endif()
            foreach(_explicit OFF ON)
                set(${_option} ${_explicit} CACHE BOOL "explicit feature choice" FORCE)
                cmake_language(EVAL CODE "${_policy}\n${_declaration}")
                if(NOT "${${_option}}" STREQUAL "${_explicit}")
                    message(FATAL_ERROR "${_option} ignored explicit ${_explicit} for ${_identities}")
                endif()
            endforeach()
            unset(${_option} CACHE)
        endforeach()
    else()
        unset(${_option})
        unset(${_option} CACHE)
        cmake_language(EVAL CODE "${_declaration}")
        set(_expected OFF)
        if(_family IN_LIST CNA_EXPECT_PROMOTED)
            set(_expected ON)
        endif()
        if(NOT "${${_option}}" STREQUAL "${_expected}")
            message(FATAL_ERROR "${_option} default is ${${_option}}, expected ${_expected}")
        endif()
        set(${_option} OFF CACHE BOOL "explicit opt-out" FORCE)
        cmake_language(EVAL CODE "${_declaration}")
        if(${_option})
            message(FATAL_ERROR "${_option} ignored an explicit OFF")
        endif()
        unset(${_option} CACHE)
    endif()
endforeach()
message(STATUS "GAP-13: qualified OPENGL33 default, twelve identity sets and explicit choices match policy")
