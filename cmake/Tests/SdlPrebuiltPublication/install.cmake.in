# SPDX-License-Identifier: MS-PL
set(_control "$ENV{CNA_SDL_FIXTURE_CONTROL}")
if(_control STREQUAL "")
    message(FATAL_ERROR "Fake SDL requires CNA_SDL_FIXTURE_CONTROL")
endif()
file(APPEND "${_control}/attempts.txt" "@_name@\n")
file(WRITE "${CMAKE_INSTALL_PREFIX}/lib/lib@_name@.so" "partial @_name@\n")
file(WRITE "${_control}/@_name@.partial" "partial\n")
if(EXISTS "${_control}/fail-@_name@")
    message(FATAL_ERROR "Injected @_name@ install interruption before publication")
endif()
if(EXISTS "${_control}/pause-@_name@")
    set(_released FALSE)
    foreach(_attempt RANGE 1 300)
        if(EXISTS "${_control}/release-@_name@")
            set(_released TRUE)
            break()
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.1)
    endforeach()
    if(NOT _released)
        message(FATAL_ERROR "Timed out waiting to release @_name@ install")
    endif()
endif()
configure_file("@CMAKE_CURRENT_BINARY_DIR@/lib@_name@.so"
    "${CMAKE_INSTALL_PREFIX}/lib/lib@_name@.so" COPYONLY)
