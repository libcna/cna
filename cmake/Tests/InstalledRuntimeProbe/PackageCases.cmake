# Each case runs in a fresh consumer so earlier imported targets cannot mask failure.
if(PROBE_CASE STREQUAL "Unknown")
    add_library(CNA::NotAComponent INTERFACE IMPORTED)
    find_package(CNA 0.1 CONFIG QUIET COMPONENTS NotAComponent)
    if(CNA_FOUND)
        message(FATAL_ERROR "A foreign target must not satisfy a missing CNA component")
    endif()
    find_package(CNA 0.1 CONFIG REQUIRED OPTIONAL_COMPONENTS NotAComponent)
    if(CNA_NotAComponent_FOUND)
        message(FATAL_ERROR "Unknown optional component was reported present")
    endif()
elseif(PROBE_CASE STREQUAL "Version")
    find_package(CNA 99 CONFIG QUIET)
    if(CNA_FOUND OR TARGET CNA::Core)
        message(FATAL_ERROR "An incompatible version must not load CNA")
    endif()
elseif(PROBE_CASE MATCHES "^(MissingSharp|MissingPkg)$")
    if(PROBE_CASE STREQUAL "MissingSharp")
        set(CMAKE_DISABLE_FIND_PACKAGE_SharpRuntime TRUE)
        set(_expected "SharpRuntime")
    else()
        # A real pkg-config with an empty search path: FindPkgConfig itself works,
        # but no multimedia development package is available to the consumer.
        file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/empty-pkgconfig")
        set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_CURRENT_BINARY_DIR}/empty-pkgconfig")
        set(ENV{PKG_CONFIG_PATH} "")
        set(_expected "libavcodec|opus")
    endif()
    find_package(CNA 0.1 CONFIG QUIET)
    if(CNA_FOUND OR TARGET CNA::Core)
        message(FATAL_ERROR "Missing dependency was ignored")
    endif()
    if(NOT CNA_NOT_FOUND_MESSAGE MATCHES "${_expected}")
        message(FATAL_ERROR "Missing dependency diagnostic: ${CNA_NOT_FOUND_MESSAGE}")
    endif()
elseif(PROBE_CASE MATCHES "^(CApiOnly|CppApiOnly|ApiThenCpp)$")
    set(CMAKE_DISABLE_FIND_PACKAGE_SharpRuntime TRUE)
    find_package(CNA 0.1 CONFIG REQUIRED COMPONENTS CApi)
    if(TARGET CNA::Core)
        message(FATAL_ERROR "Explicit CApi consumption must not load the C++ SDK")
    endif()
    add_executable(InstalledApi api.c)
    if(NOT PROBE_C_ONLY)
        set_source_files_properties(api.c PROPERTIES LANGUAGE CXX)
    endif()
    target_link_libraries(InstalledApi PRIVATE CNA::CApi)
    add_test(NAME InstalledApi COMMAND InstalledApi)
    if(PROBE_CASE STREQUAL "ApiThenCpp")
        unset(CMAKE_DISABLE_FIND_PACKAGE_SharpRuntime)
        find_package(CNA 0.1 CONFIG REQUIRED COMPONENTS Core Math)
        if(NOT TARGET CNA::Core OR NOT TARGET CNA::Math)
            message(FATAL_ERROR "Later C++ request did not load the SDK")
        endif()
        if(TARGET CNA::Shared)
            get_target_property(_links CNA::CApi INTERFACE_LINK_LIBRARIES)
            if(NOT "CNA::CNA" IN_LIST _links)
                message(FATAL_ERROR "C API lost the shared C++ runtime link contract")
            endif()
        endif()
    endif()
else()
    message(FATAL_ERROR "Unknown package probe: ${PROBE_CASE}")
endif()
