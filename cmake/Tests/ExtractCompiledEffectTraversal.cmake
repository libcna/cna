# SPDX-License-Identifier: MS-PL
# Test seam: compile the actual dispatcher, including its exception and budget boundaries,
# against fake accessor types. Never maintain a second copy of the dispatch operation list.
file(READ "${INPUT}" source)
string(REPLACE "\r\n" "\n" source "${source}")
set(extracted "// SPDX-License-Identifier: MS-PL\n// Generated from compiled_effect_fuzzer.cpp; do not edit.\n")
foreach(section IN ITEMS probe walkers)
    if(section STREQUAL "probe")
        set(first "    struct Statistics\n")
        set(last "    GraphicsDevice& SharedDevice()")
    else()
        set(first "    struct Budget\n")
        set(last "    void DrawAndRead(")
    endif()
    string(FIND "${source}" "${first}" begin)
    string(FIND "${source}" "${last}" end)
    if(begin LESS 0 OR end LESS begin)
        message(FATAL_ERROR "Compiled-effect traversal test seam moved: ${section}")
    endif()
    math(EXPR length "${end} - ${begin}")
    string(SUBSTRING "${source}" ${begin} ${length} fragment)
    string(APPEND extracted "${fragment}\n")
endforeach()
file(WRITE "${OUTPUT}" "${extracted}\n#undef FX_PROBE\n")
