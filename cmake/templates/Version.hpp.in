// SPDX-License-Identifier: MS-PL
#pragma once

#include <string_view>

/**
 * @file CNA/Version.hpp
 * @brief The CNA release a translation unit is compiled against.
 *
 * Generated by cmake/Version.cmake from cmake/templates/Version.hpp.in. The version itself is
 * decided in one place only -- project(CNA VERSION ...) and CNA_VERSION_PRERELEASE in the root
 * CMakeLists.txt (see docs/releasing.md). Never edit the generated copy in the build tree.
 *
 * This is CNA's own product version, deliberately independent of two other numbers it is easy
 * to confuse it with: CNA_ABI_VERSION in CNA/C/abi.h versions the native C ABI's binary
 * contract, and the XNA API level this framework reimplements is fixed at XNA 4.0.
 *
 * The object-like macros exist because a constexpr value cannot be tested by the preprocessor;
 * use them for compile-time feature gating (`#if CNA_VERSION_MAJOR >= 1`) and the functions
 * below for everything else.
 */

/** @brief Major component of the CNA release, as a preprocessor-testable integer literal. */
#define CNA_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/** @brief Minor component of the CNA release, as a preprocessor-testable integer literal. */
#define CNA_VERSION_MINOR @PROJECT_VERSION_MINOR@

/** @brief Patch component of the CNA release, as a preprocessor-testable integer literal. */
#define CNA_VERSION_PATCH @PROJECT_VERSION_PATCH@

/** @brief Pre-release identifier without its leading '-'; an empty string on a final release. */
#define CNA_VERSION_PRERELEASE "@CNA_VERSION_PRERELEASE@"

/** @brief The complete release string, e.g. "0.1.0-alpha.1". */
#define CNA_VERSION_STRING "@CNA_VERSION_STRING@"

namespace CNA
{
    /**
     * @brief Returns the major component of the CNA release being compiled against.
     *
     * @return The Semantic Versioning major component.
     */
    [[nodiscard]] constexpr int getVersionMajor() noexcept
    {
        return CNA_VERSION_MAJOR;
    }

    /**
     * @brief Returns the minor component of the CNA release being compiled against.
     *
     * @return The Semantic Versioning minor component.
     */
    [[nodiscard]] constexpr int getVersionMinor() noexcept
    {
        return CNA_VERSION_MINOR;
    }

    /**
     * @brief Returns the patch component of the CNA release being compiled against.
     *
     * @return The Semantic Versioning patch component.
     */
    [[nodiscard]] constexpr int getVersionPatch() noexcept
    {
        return CNA_VERSION_PATCH;
    }

    /**
     * @brief Returns the pre-release identifier of the CNA release being compiled against.
     *
     * The leading '-' is not part of the value: the release 0.1.0-alpha.1 reports "alpha.1".
     *
     * @return The pre-release identifier, or an empty view on a final release.
     */
    [[nodiscard]] constexpr std::string_view getVersionPreRelease() noexcept
    {
        return CNA_VERSION_PRERELEASE;
    }

    /**
     * @brief Returns the complete release string of the CNA release being compiled against.
     *
     * @return The version in Semantic Versioning spelling, e.g. "0.1.0-alpha.1"; no leading 'v'.
     */
    [[nodiscard]] constexpr std::string_view getVersionString() noexcept
    {
        return CNA_VERSION_STRING;
    }

    /**
     * @brief Reports whether this build is a pre-release (alpha, beta or release candidate).
     *
     * @return True when a pre-release identifier is present, false on a final release.
     */
    [[nodiscard]] constexpr bool isPreReleaseVersion() noexcept
    {
        return !getVersionPreRelease().empty();
    }
}
