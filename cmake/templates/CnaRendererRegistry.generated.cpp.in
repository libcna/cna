    {
        return Table().size();
    }

    const GraphicsRendererDescriptor* Find(GraphicsRendererType type)
    {
        for (const GraphicsRendererDescriptor& descriptor : Table())
        {
            if (descriptor.type == type)
                return &descriptor;
        }
        return nullptr;
    }

    const GraphicsRendererDescriptor* Find(std::string_view name)
    {
        for (const GraphicsRendererDescriptor& descriptor : Table())
