include_guard(GLOBAL)

# Collect every configured directory after the complete target graph exists. BUILDSYSTEM_TARGETS is
# directory-local, so walking SUBDIRECTORIES is the only reliable way to cover module-owned tests
# and examples without making every module repeat IDE-only bookkeeping.
function(_cna_collect_build_directories out_var directory)
    set(_directories "${directory}")
    get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        _cna_collect_build_directories(_descendants "${_child}")
        list(APPEND _directories ${_descendants})
    endforeach()
    set(${out_var} "${_directories}" PARENT_SCOPE)
endfunction()

function(_cna_dependency_folder out_var source_root source_dir)
    file(RELATIVE_PATH _relative "${source_root}" "${source_dir}")
    if(_relative MATCHES "^(third_party|vendor)/([^/]+)")
        set(_name "${CMAKE_MATCH_2}")
    else()
        get_filename_component(_name "${source_dir}" NAME)
    endif()
    if(_name STREQUAL "")
        set(_name Other)
    endif()
    set(${out_var} "Dependencies/${_name}" PARENT_SCOPE)
endfunction()

function(cna_assign_ide_folders)
    if(ARGC GREATER 0)
        set(_source_root "${ARGV0}")
    else()
        set(_source_root "${CMAKE_SOURCE_DIR}")
    endif()
    get_filename_component(_source_root "${_source_root}" ABSOLUTE)
    set_property(GLOBAL PROPERTY USE_FOLDERS ON)
    set_property(GLOBAL PROPERTY PREDEFINED_TARGETS_FOLDER "CMake")
    _cna_collect_build_directories(_directories "${_source_root}")

    foreach(_directory IN LISTS _directories)
        get_property(_targets DIRECTORY "${_directory}" PROPERTY BUILDSYSTEM_TARGETS)
        foreach(_target IN LISTS _targets)
            get_target_property(_imported "${_target}" IMPORTED)
            if(_imported)
                continue()
            endif()
            get_target_property(_source_dir "${_target}" SOURCE_DIR)
            file(RELATIVE_PATH _relative "${_source_root}" "${_source_dir}")
            if(_relative MATCHES "^\.\./" OR IS_ABSOLUTE "${_relative}"
               OR _relative MATCHES "^(third_party|vendor)(/|$)")
                _cna_dependency_folder(_folder "${_source_root}" "${_source_dir}")
                set_target_properties("${_target}" PROPERTIES FOLDER "${_folder}")
                continue()
            endif()

            get_target_property(_type "${_target}" TYPE)
            string(TOLOWER "${_target}" _target_lower)
            if(_relative MATCHES "(^|/)tests?(/|$)"
               OR _target_lower MATCHES "(^|_)(test|tests|conformance|parity)(_|$)")
                set(_folder "CNA/Tests")
            elseif(_target_lower MATCHES "^cnatests?$" OR _target_lower MATCHES "^cna.*tests$")
                set(_folder "CNA/Tests")
            elseif(_target_lower MATCHES "^cna_renderer_")
                set(_folder "CNA/Renderers")
            elseif(_relative MATCHES "(^|/)examples?(/|$)" OR _target_lower MATCHES "^cna_(demo|example)_")
                set(_folder "CNA/Examples")
            elseif(_target_lower MATCHES "(^|_)(tool|harness|probe|fuzzer|benchmark)(_|$)"
                   OR _target_lower STREQUAL "cna_content_tool")
                set(_folder "CNA/Tools")
            elseif(_type STREQUAL "EXECUTABLE")
                set(_folder "CNA/Applications")
            elseif(_type STREQUAL "UTILITY")
                set(_folder "CNA/Build")
            else()
                set(_folder "CNA/Libraries")
            endif()
            set_target_properties("${_target}" PROPERTIES FOLDER "${_folder}")
        endforeach()
    endforeach()
endfunction()
