{
 "task": "HND-XACT-05",
 "source": "Refresh-selected genuine Microsoft XACT3.6 x86 and x64, native-v6-cardinality cells (PROVENANCE.json)",
 "rule": [
  "A play-wave event with raw loop byte n (0..4 measured) plays its wave n+1 times; the track properties report loopCount n and duration (n+1) x the wave length.",
  "PlayWaveTrackVariation with NEW_ON_LOOP (variation bit 22): every pass is a separate complete wave (n+1 PREPARED/PLAY/STOP/DESTROY), each the next ordered candidate.",
  "PlayWave, or PlayWaveTrackVariation without NEW_ON_LOOP: one wave (the first ordered candidate) is held for n+1 passes; a single PREPARED/PLAY/STOP/DESTROY.",
  "The play-wave flags byte (0x0c versus 0x00: Use Center Speaker 0x04, New Speaker Position On Loop 0x08) changes nothing."
 ],
 "measured_on": [
  "event types 1 and 3, ordered track variation with two candidates in one resident bank",
  "flags 0x0c and 0x00",
  "raw loop bytes 0,1,2,3,4",
  "one-second waves without a loop region",
  "x86 and x64, lookahead 250 ms, two repeats of the type-3 NEW_ON_LOOP sweep"
 ],
 "not_measured": [
  "event types 4 and 6 (effect variations) and their effect NEW_ON_LOOP bits",
  "waves with a loop region (what the delegated wave loop repeats)",
  "random/shuffle track variations",
  "raw bytes 5..254; 255 keeps CNA's owner-approved policy",
  "streaming banks, cross-bank candidates and Microsoft PCM/gain"
 ],
 "pass_unit": "a pass is one hold of the same architecture's one-wave resident control (about 660-700 ms under Wine's XAudio2)",
