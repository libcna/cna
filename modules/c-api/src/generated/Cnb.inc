        *out_sound = CNA_INVALID_HANDLE;
        std::string object{};
        if (const CNA_Result routeResult = ReadImportPath(wav_path, &object);
            routeResult != CNA_RESULT_SUCCESS) {
            return routeResult;
        }
        return CreateSoundEffect(Cnb::ImportWavAsCnbSoundEffect(object), out_sound);
    });
}

