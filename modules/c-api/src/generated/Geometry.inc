    return CNA::C::Detail::CallWithExceptionBarrier([&]() -> CNA_Result {
        if (out_bytes == nullptr) {
            return CNA::C::Detail::InvalidArgument("cna_bounding_frustum_get_string_size: out_bytes is null.");
        }
        const auto value = CNA::C::Detail::ToNative(c_value);
        return CNA::C::Detail::ReportTextSize(value.ToString(), out_bytes);
    });
}

CNA_Result cna_bounding_frustum_copy_string(
    const CNA_BoundingFrustum c_value,
    char* const destination,
    const uint64_t capacity,
    uint64_t* const out_bytes)
{
    return CNA::C::Detail::CopyFormattedText(destination, capacity, out_bytes, [&] {
        const auto value = CNA::C::Detail::ToNative(c_value);
        return value.ToString();
    });
}

CNA_Result cna_bounding_frustum_init_matrix(
    const CNA_Matrix c_matrix,
    CNA_BoundingFrustum* const out_value)
{
    return CNA::C::Detail::CallWithExceptionBarrier([&]() -> CNA_Result {
        if (out_value == nullptr) {
            return CNA::C::Detail::InvalidArgument("cna_bounding_frustum_init_matrix: out_value is null.");
        }
        const auto matrix = CNA::C::Detail::ToNative(c_matrix);
        *out_value = CNA::C::Detail::ToC(BoundingFrustum(matrix));
        return CNA_RESULT_SUCCESS;
    });
}
