CNA_Result cna_touch_state_get_is_read_only(
    const CNA_TouchState* const state,
    CNA_Bool* const out_read_only)
{
    return CNA::C::Detail::CallWithExceptionBarrier([&]() -> CNA_Result {
        if (out_read_only == nullptr) {
            return CNA::C::Detail::InvalidArgument("cna_touch_state_get_is_read_only: out_read_only is null.");
        }
        if (const CNA_Result routeResult = ValidateTouchState(state);
            routeResult != CNA_RESULT_SUCCESS) {
            return routeResult;
        }
        *out_read_only = CNA::C::Detail::ToCBool(TouchCollection().getIsReadOnlyProperty());
        return CNA_RESULT_SUCCESS;
    });
}

CNA_Result cna_touch_state_get_is_empty_ext(
    const CNA_TouchState* const state,
    CNA_Bool* const out_empty)
{
