        if (const CNA_Result routeResult = CNA::C::Detail::ValidateCanonicalBool(c_exists, "exists");
            routeResult != CNA_RESULT_SUCCESS) {
            return routeResult;
        }
        if (const CNA_Result routeResult = ValidateActiveGameHandle(game);
            routeResult != CNA_RESULT_SUCCESS) {
            return routeResult;
        }
        const bool exists = CNA::C::Detail::FromCBool(c_exists);
        TouchPanel::setTouchDeviceExistsProperty(exists);
        return CNA_RESULT_SUCCESS;
    });
}

