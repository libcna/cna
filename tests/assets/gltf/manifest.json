      ],
      "firstDivergentLayer": "L3",
      "status": "partially-remediated",
      "fixtures": [
        "mode-triangle-strip",
        "mode-points"
      ]
    },
    {
      "id": "D6",
      "summary": "Rigid (unskinned) node animation is silently dropped. ExtractClips resolves every channel target against the skin's joint set, so a channel targeting an ordinary mesh node is discarded with no warning and no clip is emitted.",
      "owner": "GLTF-ANIMATION",
      "owningTasks": [
        "GLTF-103",
        "GLTF-113",
