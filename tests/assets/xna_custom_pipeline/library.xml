    <Name>The Dawn Errand, Annotated</Name>
    <Chapters>
      <Item>The Gate</Item>
      <Item>The Well</Item>
      <Item>The Tower</Item>
    </Chapters>
    <Opening>
      <Position>0 0 0</Position>
      <Label>gate</Label>
    </Opening>
    <RecommendedLevel>7</RecommendedLevel>
  </Asset>
</XnaContent>
