<?xml version="1.0" encoding="utf-8"?>
<!--
  plans/plan_xnapipeline_parity.md XNAPP-320: the CMake helper's `.contentproj` fixture.

  This is what an XNA developer has: a content project naming its own platform, profile and
  per-item Importer/Processor, plus a None item the targets copy rather than build. It is built
  from CMake by `cna_add_content(... CONTENT_PROJECT ...)`, which is the route this file exists
  to prove; `docs/xna-content-pipeline-migration.md` is the guide it belongs to.
-->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{7C6E1A44-9C2B-4C1E-9C3D-8F0F5B2A7E11}</ProjectGuid>
    <XnaFrameworkVersion>v4.0</XnaFrameworkVersion>
    <XnaPlatform>Windows</XnaPlatform>
    <XnaProfile>Reach</XnaProfile>
    <ContentRootDirectory>Content</ContentRootDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Textures\probe.png">
      <Name>probe</Name>
      <Importer>TextureImporter</Importer>
      <Processor>TextureProcessor</Processor>
      <ProcessorParameters_GenerateMipmaps>False</ProcessorParameters_GenerateMipmaps>
    </Compile>
    <None Include="readme.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
