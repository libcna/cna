   "project": "2d-shooters.contentproj",
   "sourceRoot": "expanded/2d-shooters/Content",
   "recurse": false,
   "platform": "Windows",
   "profile": "Reach",
   "compress": false,
   "items": [
    {"match": "*.jpg", "importer": "TextureImporter", "processor": "TextureProcessor", "assetName": "{stem}/{stem}"},
