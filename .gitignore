# Task 471: tools/fna-reference/ C# build output (bin/, obj/) and its generated JSON output --
# not source, all regenerated by `xbuild`/running the tool.
tools/fna-reference/bin/
tools/fna-reference/obj/

# DXVK shader/pipeline state cache, written next to wherever a D3D9/D3D11/D3D12 test .exe was
# invoked from (e.g. running a CTest binary directly from the repo root) -- runtime artifact, not
# source.
*.dxvk-cache



# CTest scratch (Testing/Temporary/LastTest.log, CTestCostData.txt), written into whatever
# directory ctest was invoked from -- including the repo root when a build dir is passed with -C
# or the invocation misses. Runtime artifact, not source.
Testing/

# plan_modern.md MOD-7: generated Doxygen output for the CNA::Graphics engine layer
# (`doxygen docs/Doxyfile.cnaext`, or the CNAEXT_DoxygenGroup ctest). Regenerated, never source.
build/doxygen-cnaext/
