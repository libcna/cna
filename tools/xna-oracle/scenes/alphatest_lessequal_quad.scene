# plans/plan_dx9.md D9-A5 scene corpus: alphatest_lessequal_quad
# The first scene to exercise AlphaFunction=LessEqual, which shares the SAME PSAlphaTestLtGt
# shader bucket as Greater/Less/GreaterEqual (confirmed against FNA's own AlphaTestEffect.cs) but
# differs from plain Less specifically at the EXACT boundary value: `alphaTest.X =
# reference + threshold` (vs. Less's `reference - threshold`), so a texel whose alpha exactly
# equals ReferenceAlpha passes under LessEqual but would be discarded under plain Less
# (AlphaTestEffect.cs: LessEqual case, immediately below the Less case).
#
# Reuses alphatest_equal_quad.scene's exact texture (alpha=128,127,129,1) and ReferenceAlpha=128
# for the same reason alphatest_greaterequal_quad.scene does -- it already has a texel at the
# EXACT boundary. Under LessEqual: alpha=128 (exact match) now PASSES (unlike plain Less, where
# it would fail); alpha=127 (below) PASSES; alpha=129 (above) FAILS; alpha=1 (far below) PASSES.
# A renderer that silently treated LessEqual identically to Less would incorrectly discard the
# alpha=128 texel here -- this scene exists specifically to close that verification gap, and
# together with alphatest_greaterequal_quad.scene completes coverage of all 6 AlphaFunction
# values that share the PSAlphaTestLtGt bucket (Less/LessEqual/GreaterEqual/Greater are now all
# represented; Never/Always are the only two left, both alpha-value-independent).
width=256
height=256
profile=HiDef
clearcolor=100,149,237,255
effect=AlphaTestEffect
vertexformat=PositionTexture
vertexcolor=false
texture=true
texturewidth=2
textureheight=2
texturefilter=Point
alphafunction=LessEqual
referencealpha=128
primitive=TriangleList
# Row-major, top row first: (red,a=128 EXACT MATCH -> PASSES under LessEqual) /
# (white,a=127 -> PASSES) ; (white,a=129 -> FAILS) / (blue,a=1 -> PASSES).
texturepixel=255,0,0,128
texturepixel=255,255,255,127
texturepixel=255,255,255,129
texturepixel=0,0,255,1
# UV (0,0) is the texture's top-left (red, alpha=128, passes under LessEqual but would fail
# under plain Less -- the whole point of this scene).
vertex=-0.6,0.6,0,0,0
vertex=0.6,0.6,0,1,0
vertex=-0.6,-0.6,0,0,1
vertex=0.6,0.6,0,1,0
vertex=0.6,-0.6,0,1,1
vertex=-0.6,-0.6,0,0,1
