# DX9 audit scene: render-target sampling
# Draw an asymmetric point-filtered quad into RenderTarget2D, unbind it, and sample the resulting
# texture over the complete output through SpriteBatch. This distinguishes a working sampled
# render target from a path that only supports binding, clearing, readback, or direct rendering.
width=256
height=256
profile=HiDef
clearcolor=100,149,237,255
rendertargetsample=true
vertexformat=PositionTexture
vertexcolor=false
lighting=false
texture=true
texturewidth=2
textureheight=2
texturefilter=Point
primitive=TriangleList
# Asymmetric row-major pattern: red,green / white,blue.
texturepixel=255,0,0,255
texturepixel=0,255,0,255
texturepixel=255,255,255,255
texturepixel=0,0,255,255
vertex=-0.6,0.6,0,0,0
vertex=0.6,0.6,0,1,0
vertex=-0.6,-0.6,0,0,1
vertex=0.6,0.6,0,1,0
vertex=0.6,-0.6,0,1,1
vertex=-0.6,-0.6,0,0,1
