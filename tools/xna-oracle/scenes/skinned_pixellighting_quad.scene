# plans/plan_dx9.md D9-A5 scene corpus: skinned_pixellighting_quad
# First scene to exercise SkinnedEffect.PreferPerPixelLighting=true (plans/plan_dx9.md D9-81 item 1,
# resolved 2026-07-16). Same left/right split-normal discriminator as
# lit_textured_quad_pixellighting.scene's own header comment explains in full (a flat,
# single-normal quad cannot tell vertex-lit and pixel-lit apart at all -- see that scene's own
# comment for why) -- left-edge vertices face the light (0,0,1), right-edge vertices tilt away
# (0.7071,0,-0.7071, clamped to zero by BasicEffect/SkinnedEffect's shared max(0,dot) lighting
# math), giving both triangles genuine within-triangle normal variation.
#
# Single Identity bone at 100% weight (same no-op-skinning convention skinned_quad.scene
# established) -- this is D9-73's own outstanding oracle-proof obligation for
# VSSkinnedPixelLightingOneBone/PSSkinnedPixelLighting, one of the 5 shader variants that do NOT
# byte-match Microsoft's shipped .fxb (a compiler-version difference, not a flag).
width=256
height=256
profile=HiDef
clearcolor=100,149,237,255
effect=SkinnedEffect
vertexformat=PositionNormalTextureWeights
lighting=true
preferpixellighting=true
ambientcolor=0,0,0
light0enabled=true
light0diffuse=0.8,0.8,0.8
light0direction=0,0,-1
texture=true
texturewidth=1
textureheight=1
texturefilter=Point
weightspervertex=1
primitive=TriangleList
texturepixel=255,255,255,255
# x,y,z,nx,ny,nz,u,v,boneindex,boneweight -- left-edge vertices face the light (0,0,1);
# right-edge vertices tilt away (0.7071,0,-0.7071), same split as
# lit_textured_quad_pixellighting.scene. Bound 100% to bone 0 (the single Identity bone).
vertex=-0.6,0.6,0,0,0,1,0,0,0,1.0
vertex=0.6,0.6,0,0.7071,0,-0.7071,1,0,0,1.0
vertex=-0.6,-0.6,0,0,0,1,0,1,0,1.0
vertex=0.6,0.6,0,0.7071,0,-0.7071,1,0,0,1.0
vertex=0.6,-0.6,0,0.7071,0,-0.7071,1,1,0,1.0
vertex=-0.6,-0.6,0,0,0,1,0,1,0,1.0
