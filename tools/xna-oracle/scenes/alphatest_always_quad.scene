# plans/plan_dx9.md D9-A5 scene corpus: alphatest_always_quad
# The last of the 8 XNA AlphaTestEffect.AlphaFunction values to land in this corpus:
# AlphaFunction=Always. Confirmed against FNA's own AlphaTestEffect.cs source: Always sets
# `alphaTest.Z = 1; alphaTest.W = 1;` (both branch targets positive) -- the shader's
# `clip((a < x) ? z : w)` evaluates to clip(1) UNCONDITIONALLY, never discarding any fragment
# regardless of its actual alpha value. Reuses alphatest_quad.scene's exact texture
# (alpha=255,1,255,64) unchanged -- under plain Greater, the alpha=1 and alpha=64 texels would
# normally be DISCARDED (both well below ReferenceAlpha=128), but under Always they must ALL
# survive and show their own raw color, including the ones that would otherwise clearly fail.
# Together with alphatest_never_quad.scene, this completes coverage of all 8 real XNA
# AlphaTestEffect.AlphaFunction values in the corpus (Less/LessEqual/GreaterEqual/Greater/Never/
# Always on PSAlphaTestLtGt; Equal/NotEqual on the separate PSAlphaTestEqNe bucket).
width=256
height=256
profile=HiDef
clearcolor=100,149,237,255
effect=AlphaTestEffect
vertexformat=PositionTexture
vertexcolor=false
texture=true
texturewidth=2
textureheight=2
texturefilter=Point
alphafunction=Always
referencealpha=128
primitive=TriangleList
# Row-major, top row first: (red,a=255),(white,a=1) / (white,a=255),(blue,a=64) -- same texture as
# alphatest_quad.scene; every texel here should PASS under Always regardless of its alpha,
# including the two (a=1, a=64) that would fail under plain Greater.
texturepixel=255,0,0,255
texturepixel=255,255,255,1
texturepixel=255,255,255,255
texturepixel=0,0,255,64
vertex=-0.6,0.6,0,0,0
vertex=0.6,0.6,0,1,0
vertex=-0.6,-0.6,0,0,1
vertex=0.6,0.6,0,1,0
vertex=0.6,-0.6,0,1,1
vertex=-0.6,-0.6,0,0,1
