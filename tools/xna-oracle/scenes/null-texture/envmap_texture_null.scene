# plans/plan_graphics_shared_cleanup.md GSC-0004: what a real XNA 4.0 stock effect samples from an
# unbound texture slot. EnvironmentMapEffect with Texture=null over a (200,100,50) cube, amount 0.5,
# no fresnel, ambient white: lerp(sample, cube, 0.5). White would give ~(228,178,153), black (100,50,25).
# The clear colour has alpha 255 and the default BlendState.Opaque writes the effect's alpha, so the
# result separates opaque black (0,0,0,255), transparent black (0,0,0,0) and white.
# Deliberately in scenes/null-texture/, outside every renderer script's scenes/*.scene glob.
width=64
height=64
profile=HiDef
clearcolor=100,149,237,255
effect=EnvironmentMapEffect
vertexformat=PositionNormalTexture
lighting=true
ambientcolor=1,1,1
light0enabled=false
texture=false
environmentmap=true
environmentmapsize=1
environmentmappixel=200,100,50,255
environmentmapamount=0.5
fresnelfactor=0
primitive=TriangleList
vertex=-0.6,0.6,0,0,0,1,0,0
vertex=0.6,0.6,0,0,0,1,1,0
vertex=-0.6,-0.6,0,0,0,1,0,1
vertex=0.6,0.6,0,0,0,1,1,0
vertex=0.6,-0.6,0,0,0,1,1,1
vertex=-0.6,-0.6,0,0,0,1,0,1
