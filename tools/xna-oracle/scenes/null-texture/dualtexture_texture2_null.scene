# plans/plan_graphics_shared_cleanup.md GSC-0004: what a real XNA 4.0 stock effect samples from an
# unbound texture slot. DualTextureEffect with a white Texture and Texture2=null, DiffuseColor 0.5:
# texture * texture2 * 2 * diffuse is the second sample itself.
# The clear colour has alpha 255 and the default BlendState.Opaque writes the effect's alpha, so the
# result separates opaque black (0,0,0,255), transparent black (0,0,0,0) and white.
# Deliberately in scenes/null-texture/, outside every renderer script's scenes/*.scene glob.
width=64
height=64
profile=HiDef
clearcolor=100,149,237,255
effect=DualTextureEffect
vertexformat=PositionDualTexture
vertexcolor=false
texture=true
texturewidth=1
textureheight=1
texturefilter=Point
texturepixel=255,255,255,255
texture2=false
diffusecolor=0.5,0.5,0.5
primitive=TriangleList
vertex=-0.6,0.6,0,0,0,0,0
vertex=0.6,0.6,0,1,0,1,0
vertex=-0.6,-0.6,0,0,1,0,1
vertex=0.6,0.6,0,1,0,1,0
vertex=0.6,-0.6,0,1,1,1,1
vertex=-0.6,-0.6,0,0,1,0,1
