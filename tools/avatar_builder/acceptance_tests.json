 "allowedSkips": {
  "AvatarRendererTest.AFailedGpuUploadFailsEveryDrawCleanlyRatherThanHalfBuilding": {
   "renderers": null,
   "reason": "needs a renderer that refuses vertex buffers; none of today's does"
  },
  "AvatarRendererTest.DrawsEveryPresetAndExpressionOnTheDispatcherDevice": {
   "renderers": [
    "STUB"
   ],
   "reason": "STUB has no 3D pipeline"
  },
  "AvatarRendererTest.EveryFormat3FeatureDrawsAndANewDeviceGetsItsOwnResources": {
   "renderers": [
    "STUB"
   ],
   "reason": "STUB has no 3D pipeline"
  }
 },
 "ctest": {
  "about": "CTest entries outside CnaTests that the acceptance runs once, with the build's default renderer, through the private runner; each must be registered and pass (a skip fails). 'target' is what the build stage builds for it; 'defaultRenderers' limits an entry to the trees whose default renderer registers it.",
  "tests": [
   {
    "name": "EasyGL_AvatarRenderer_Standard",
    "target": "cna_test_avatar_standard_render",
    "defaultRenderers": [
     "OPENGLES3",
     "OPENGL33",
     "WEBGL2"
    ]
   },
   {
    "name": "CApi_AvatarsSmoke",
    "target": "cna_c_api_avatars_smoke"
   },
   {
    "name": "CApi_AvatarIdentitiesSmoke",
    "target": "cna_c_api_avatar_identities_smoke"
   },
   {
    "name": "CApi_AvatarExitWhileLoadingSmoke",
    "target": "cna_c_api_avatar_exit_while_loading_smoke"
   },
   {
