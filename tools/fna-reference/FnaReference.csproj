<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowedReferenceRelatedFileExtensions>.pdb;.xml</AllowedReferenceRelatedFileExtensions>
    <FnaAssemblyPath Condition="'$(FnaAssemblyPath)' == ''">$(FNA_ASSEMBLY_PATH)</FnaAssemblyPath>
  </PropertyGroup>
  <Target Name="ValidateFnaReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(FnaAssemblyPath)' == ''"
           Text="Set FnaAssemblyPath (MSBuild property) or FNA_ASSEMBLY_PATH to the FNA.Core.csproj net8.0 FNA.dll." />
    <Error Condition="'$(FnaAssemblyPath)' != '' and !Exists('$(FnaAssemblyPath)')"
           Text="FNA reference does not exist: $(FnaAssemblyPath)" />
  </Target>
  <ItemGroup>
    <Reference Include="FNA">
      <HintPath>$(FnaAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
