<?xml version="1.0" encoding="utf-8"?>
<!--
  Task 471 (plans/plan_graphics.md Phase 53): small FNA reference-app generator.

  A minimal console app referencing the real FNA.dll (built from the local FNA source tree,
  /rv/data/library/github.com/FNA-XNA/FNA, via `xbuild FNA.csproj /p:Configuration=Debug`) so
  Tasks 472+ can query FNA's own real C# classes directly -API defaults, exception behavior,
  enum numeric values, PackedVector bit layouts, stock-effect constants -and emit them as JSON
  for CNA's own C++ tests to eventually diff against, rather than relying on hand-read-and-typed
  transcriptions of the FNA source (this project's own established behavior-fidelity discipline,
  CLAUDE.md's "Behavior Fidelity" section, taken one step further: verified by *running* the real
  reference implementation, not just reading it).

  Deliberately old-style (ToolsVersion 4.0, no SDK-style project), matching FNA's own FNA.csproj
  exactly -this sandbox has mono/xbuild but no `dotnet` CLI or nuget, so an SDK-style project or
  any NuGet-fetched dependency (e.g. Newtonsoft.Json) is not viable; JsonWriter.cs is a tiny,
  dependency-free hand-rolled JSON writer instead.

  Build (from this directory), matching FNA's own build convention exactly:
    xbuild FnaReference.csproj /p:Configuration=Debug
  Run:
    mono bin/Debug/FnaReference.exe
-->
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProductVersion>9.0.21022</ProductVersion>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{8F6B6A8B-9F1E-4E9A-9C2F-2B7B6E7E7B01}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>CNA.FnaReference</RootNamespace>
    <AssemblyName>FnaReference</AssemblyName>
    <LangVersion>4</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugSymbols>True</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>False</Optimize>
    <OutputPath>bin\Debug</OutputPath>
    <DefineConstants>DEBUG;</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x86</PlatformTarget>
    <ConsolePause>False</ConsolePause>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <DebugType>none</DebugType>
    <Optimize>True</Optimize>
    <OutputPath>bin\Release</OutputPath>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x86</PlatformTarget>
    <ConsolePause>False</ConsolePause>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
  </ItemGroup>
  <ItemGroup>
    <!-- Absolute path, matching CLAUDE.md's own documented "Source Reference" convention for
         this project (the local FNA checkout always lives at this fixed sandbox path),
         simpler and less error-prone than counting ".." levels back out of tools/fna-reference/. -->
    <Reference Include="FNA">
      <HintPath>/rv/data/library/github.com/FNA-XNA/FNA/bin/Debug/FNA.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="EffectReflectionReference.cs" />
    <Compile Include="EffectStateReference.cs" />
    <Compile Include="JsonWriter.cs" />
    <Compile Include="NonRenderingApiReference.cs" />
    <Compile Include="PackedVectorReference.cs" />
    <Compile Include="ViewportReference.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
</Project>
